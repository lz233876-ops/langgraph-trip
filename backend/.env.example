
# LLM配置 (LangChain ChatOpenAI, 兼容任意OpenAI格式端点)
# 也兼容 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL 命名
# 模型名称 (OpenAI: gpt-4o/gpt-4o-mini, DeepSeek: deepseek-chat, 通义: qwen-plus ...)
LLM_MODEL_ID=

# API密钥
LLM_API_KEY=

# 服务地址 (OpenAI官方端点留空即可; DeepSeek填 https://api.deepseek.com/v1)
LLM_BASE_URL=

# 温度 (可选, 默认0.7)
LLM_TEMPERATURE=0.7

# 超时时间 (可选, 默认60秒)
LLM_TIMEOUT=60.0

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# 高德地图API配置
AMAP_API_KEY=
